APP_NAME=Nestora API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nestora
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nestora

FRONTEND_URL=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15

OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@nestora.local
SMTP_USE_TLS=true

MAPBOX_ACCESS_TOKEN=

TRANSFER_BASE_FARE=120
TRANSFER_PER_KM_RATE=22
TRANSFER_MINIMUM_FARE=180
TRANSFER_AIRPORT_SURCHARGE=150
TRANSFER_RAILWAY_SURCHARGE=60
TRANSFER_BUS_SURCHARGE=40

BOOKING_HOLD_MINUTES=15

PAYMENT_PROVIDER=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ROUTE_ENABLED=false
RAZORPAY_ROUTE_WEBHOOK_REQUIRED=true

CANCELLATION_FULL_REFUND_HOURS=48
CANCELLATION_PARTIAL_REFUND_HOURS=24
CANCELLATION_PARTIAL_REFUND_PERCENT=50

PLATFORM_COMMISSION_PERCENT=12

LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
OTP_RESEND_COOLDOWN_SECONDS=60

REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=nestora_refresh_token
REFRESH_COOKIE_SECURE=false
JOB_WORKER_ENABLED=true

REDIS_URL=redis://localhost:6379/0
REDIS_JOB_QUEUE=nestora:jobs

STORAGE_PROVIDER=local
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
CDN_BASE_URL=

GST_ENABLED=false
GST_RATE_PERCENT=18

SENTRY_DSN=
