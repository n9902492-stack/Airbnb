APP_NAME=Nestora API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nestora
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nestora

FRONTEND_URL=http://localhost:5173
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@nestora.local
SMTP_USE_TLS=true

MAPBOX_ACCESS_TOKEN=

TRANSFER_BASE_FARE=120
TRANSFER_PER_KM_RATE=22
TRANSFER_MINIMUM_FARE=180
TRANSFER_AIRPORT_SURCHARGE=150
TRANSFER_RAILWAY_SURCHARGE=60
TRANSFER_BUS_SURCHARGE=40

BOOKING_HOLD_MINUTES=15

PAYMENT_PROVIDER=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CANCELLATION_FULL_REFUND_HOURS=48
CANCELLATION_PARTIAL_REFUND_HOURS=24
CANCELLATION_PARTIAL_REFUND_PERCENT=50

PLATFORM_COMMISSION_PERCENT=12

LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
OTP_RESEND_COOLDOWN_SECONDS=60
