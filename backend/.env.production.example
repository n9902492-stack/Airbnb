APP_NAME=Nestora API
APP_ENV=production
APP_DEBUG=false
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@postgres:5432/nestora

FRONTEND_URL=https://www.example.com
ALLOWED_HOSTS=api.example.com,localhost
SECRET_KEY=replace-with-at-least-32-random-characters

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=nestora_refresh_token
REFRESH_COOKIE_SECURE=true

REDIS_URL=redis://redis:6379/0
REDIS_JOB_QUEUE=nestora:jobs
JOB_WORKER_ENABLED=false

STORAGE_PROVIDER=s3
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
CDN_BASE_URL=https://cdn.example.com

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true

MAPBOX_ACCESS_TOKEN=

PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ROUTE_ENABLED=true
RAZORPAY_ROUTE_WEBHOOK_REQUIRED=true

GST_ENABLED=false
GST_RATE_PERCENT=18

PLATFORM_COMMISSION_PERCENT=12
BOOKING_HOLD_MINUTES=15

LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
OTP_RESEND_COOLDOWN_SECONDS=60

SENTRY_DSN=
